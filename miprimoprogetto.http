#####################################################################
#                     SECURITY TESTS - NEW                          #
#####################################################################

### TEST 1: Register con weak password (DEVE FALLIRE - meno di 12 caratteri)
POST {{miprimoprogetto_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "lastName": "WeakPassword",
  "email": "security.test1@email.com",
  "password": "weak123"
}

### TEST 2: Register con strong password (DEVE RIUSCIRE - 12+ chars, uppercase, lowercase, number, special)
POST {{miprimoprogetto_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "lastName": "StrongPassword",
  "email": "security.test2@email.com",
  "password": "SecureP@ss123"
}
### security.test2@email.com
@testEmail = einstein@email.com
@testPassword = SecureP@ss123
@testEmailWeakPwd = security.test3@email.com

### TEST 3: Register con strong password (per test email verification)
POST {{miprimoprogetto_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Email Test",
  "lastName": "Verification",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### TEST 4: Login PRIMA di email verification (DEVE FALLIRE - "Email non ancora verificata")
POST {{miprimoprogetto_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### TEST 5: Verify Email (DEVE RIUSCIRE - usa token dall'email di verifica)
### NOTA: Copia il token dall'email di verifica ricevuta durante la registrazione
GET {{miprimoprogetto_HostAddress}}/api/auth/verify-email?email={{testEmail}}&token=hEx-wKS2gYIJJdha3QQuMg_MZim4sE68g8Rvsx2fDSY


### TEST 6: Login DOPO email verification (DEVE RIUSCIRE)
POST {{miprimoprogetto_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### TEST 7: Change Password con weak password (DEVE FALLIRE - non abbastanza forte)
POST {{miprimoprogetto_HostAddress}}/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "{{authPassword}}",
  "newPassword": "weak99"
}

### TEST 8: Change Password con strong password (DEVE RIUSCIRE)
POST {{miprimoprogetto_HostAddress}}/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "{{authPassword}}",
  "newPassword": "NewSecure@Pass9"
}

