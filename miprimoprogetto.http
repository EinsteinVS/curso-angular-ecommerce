#####################################################################
#                     PRODUCT IMAGES - READ                         #
#####################################################################

### Get all images of a product
GET {{miprimoprogetto_HostAddress}}/api/products/1002/images
Accept: application/json

### Get product image by id
GET {{miprimoprogetto_HostAddress}}/api/products/2/images/3
Accept: application/json


#####################################################################
#                     PRODUCT IMAGES - CREATE                       #
#####################################################################

### Add image to product (Require Admin or Manager)
POST {{miprimoprogetto_HostAddress}}/api/products/1002/images
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": 1002,
  "imageUrl": "https://mybucket.s3.amazonaws.com/products/1/laptop-angle-1.jpg",
  "altText": "Laptop front view",
  "displayOrder": 1,
  "isPrimary": true
}

### Add second image to product (Require Admin or Manager)
POST {{miprimoprogetto_HostAddress}}/api/products/1002/images
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": 1002,
  "imageUrl": "https://images.unsplash.com/photo-1567306226416-28f0efdc88ce",
  "altText": "Laptop side view 2",
  "displayOrder": 2,
  "isPrimary": false
}


