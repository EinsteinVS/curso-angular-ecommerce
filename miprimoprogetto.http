#                            SETUP                                  #
#####################################################################
@miprimoprogetto_HostAddress = http://localhost:5268
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..O-RMfN-o3e3qes-fRpBYxx5Ra5emZ4SdvK2D8YWb_WI
@authEmail = mario.rossi@email.com
@authPassword = NuovaPassword456!
#@authPassword = PasswordSicura123!


#####################################################################
#                            AUTH                                   #
#####################################################################

### Register (crea User + Customer)
POST {{miprimoprogetto_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Mario",
  "lastName": "Rossi",
  "email": "{{authEmail}}",
  "password": "{{authPassword}}",
  "tipoDocumento": "DNI",
  "numeroDocumento": "12345678",
  "phoneNumber": "+56912345678",
  "edad": "34",
  "genero": "M",
  "geo1": "Santiago, CL",
  "addresses": "Av. Providencia 1234, Santiago",
  "payments": "VISA, Mastercard"
}

### Change Password (utente autenticato)
POST {{miprimoprogetto_HostAddress}}/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "{{authPassword}}",
  "newPassword": "NuovaPassword456!"
}

### Forgot Password (genera reset token)
POST {{miprimoprogetto_HostAddress}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{authEmail}}"
}

### Reset Password (usa il token ricevuto)
POST {{miprimoprogetto_HostAddress}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "{{authEmail}}",
  "resetToken": "INCOLLA_QUI_IL_RESET_TOKEN",
  "newPassword": "NuovaPassword456!"
}

### Login (usa email/password registrati)
POST {{miprimoprogetto_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{authEmail}}",
  "password": "{{authPassword}}"
}


#####################################################################
#                         USER - READ                               #
#####################################################################

### Get all users (Require Auth)
GET {{miprimoprogetto_HostAddress}}/api/user
Accept: application/json
Authorization: Bearer {{token}}

### Get user by id
GET {{miprimoprogetto_HostAddress}}/api/user/12
Accept: application/json

### Get user by email
GET {{miprimoprogetto_HostAddress}}/api/user/email?email=einstein@gmail.com
Accept: application/json


#####################################################################
#                        USER - CREATE                              #
#####################################################################

### Create new user
POST {{miprimoprogetto_HostAddress}}/api/user
Content-Type: application/json

{
  "name": "Albert 2",
  "lastName": "Einstein 2 ",
  "email": "einstein@gmail.com",
  "phoneNumber": "+39 123 456 7890",
  "tipoDocumento": "PassportNumber",
  "numeroDocumento": "AB1234567",
  "role": "Customer",
  "isActive": true
}


#####################################################################
#                        USER - UPDATE                              #
#####################################################################

### Update user
PUT {{miprimoprogetto_HostAddress}}/api/user/2
Content-Type: application/json

{
  "id": 2,
  "name": "Albert",
  "lastName": "Einstein",
  "email": "albert.einstein@gmail.com",
  "phoneNumber": "+39 123 456 7890",
  "tipoDocumento": "PassportNumber",
  "numeroDocumento": "AB123456",
  "role": "Customer",
  "isActive": true
}


#####################################################################
#                        USER - DELETE                              #
#####################################################################

### Delete user (Require Admin Role)
DELETE {{miprimoprogetto_HostAddress}}/api/user/13
Accept: application/json
Authorization: Bearer {{token}}


