  "lastName": "Rossi",
  "email": "{{authEmail}}",
  "password": "{{authPassword}}",
  "tipoDocumento": "DNI",
  "numeroDocumento": "92345670",
  "phoneNumber": "+56912345678",
  "edad": "34",
  "genero": "M",
  "geo1": "Santiago, CL",
  "addresses": "Av. Providencia 1234, Santiago",
  "payments": "VISA, Mastercard"
}

### Change Password (utente autenticato)
POST {{miprimoprogetto_HostAddress}}/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "{{authPassword}}",
  "newPassword": "NuovaPassword456!7"
}

