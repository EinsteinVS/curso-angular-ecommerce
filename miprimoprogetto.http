{
  "email": "{{authEmail}}",
  "password": "{{authPassword}}"
}


#####################################################################
#                         USER - READ                               #
#####################################################################

### Get all users (Require Auth)
GET {{miprimoprogetto_HostAddress}}/api/user
Accept: application/json
Authorization: Bearer {{tokenAdmin}}

### Get user by id
GET {{miprimoprogetto_HostAddress}}/api/user/4
Accept: application/json
Authorization: Bearer {{token}}

### Get user by email
GET {{miprimoprogetto_HostAddress}}/api/user/email?email=einstein@gmail.com
Accept: application/json
Authorization: Bearer {{token}}

### Get my profile (Best practice e-commerce)
GET {{miprimoprogetto_HostAddress}}/api/user/me
Accept: application/json
Authorization: Bearer {{token}}


#####################################################################
#                        USER - CREATE                              #
#####################################################################

### Create new user (Require Admin Role)
POST {{miprimoprogetto_HostAddress}}/api/user
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Albert 2",
  "lastName": "Einstein 2 ",
  "email": "einstein@gmail.com",
  "phoneNumber": "+39 123 456 7890",
  "tipoDocumento": "PassportNumber",
  "numeroDocumento": "AB1234567",
  "role": "Customer",
  "isActive": true
}


#####################################################################
#                        USER - UPDATE                              #
#####################################################################

### Update user
PUT {{miprimoprogetto_HostAddress}}/api/user/4
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": 4,
  "name": "Albert",
  "lastName": "Einstein",
  "email": "albert.einstein4@gmail.com",
  "phoneNumber": "+39 123 456 7890",
  "tipoDocumento": "PassportNumber",
  "numeroDocumento": "AB123456",
  "role": "Customer",
  "isActive": true
}

### Update my profile (Best practice e-commerce) il proprio profilo. 
#Non è necessario specificare id, email, role o isActive. 
#Il sistema aggiorna solo i campi modificabili.
PUT {{miprimoprogetto_HostAddress}}/api/user/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Mario me",
  "lastName": "Rossi me",
  "phoneNumber": "+39 123 456 7890",
  "tipoDocumento": "DNI",
  "numeroDocumento": "92345678"
}


